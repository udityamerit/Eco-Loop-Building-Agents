! Eco-Loop Building Agents: Baseline Medium Office Building Model
! Adapted from DOE Reference Building (RefBldgMediumOfficeNew2004_Chicago.idf)
! Includes explicit Output:Variable and EnergyManagementSystem:Actuator definitions

Version, 23.1.0;

Building,
    EcoLoop_MediumOffice,    !- Name
    0.0,                     !- North Axis {deg}
    Suburbs,                 !- Terrain
    0.04,                    !- Loads Convergence Tolerance Value
    0.4,                     !- Temperature Convergence Tolerance Value {deltaC}
    FullInteriorAndExterior, !- Solar Distribution
    25,                      !- Maximum Number of Warmup Days
    6;                       !- Minimum Number of Warmup Days

Timestep, 1;                 !- Timestep frequency per hour (60 min / 1 = 60 min, override via runtime to 1 min)

! -----------------------------------------------------------------------------
! THERMAL ZONES & SCHEDULES
! -----------------------------------------------------------------------------
Zone,
    ZONE1,                   !- Name
    0,                       !- Direction of Relative North {deg}
    0,                       !- X Origin {m}
    0,                       !- Y Origin {m}
    0,                       !- Z Origin {m}
    1,                       !- Type
    1,                       !- Multiplier
    3.0,                     !- Ceiling Height {m}
    1500.0;                  !- Volume {m3}

Schedule:Compact,
    Zone1 Cooling Setpoint Schedule, !- Name
    Temperature,             !- Schedule Type Limits Name
    Through: 12/31,          !- Field 1
    For: AllDays,            !- Field 2
    Until: 06:00, 25.0,      !- Field 3
    Until: 18:00, 22.0,      !- Field 4
    Until: 24:00, 25.0;      !- Field 5

Schedule:Compact,
    Zone1 Heating Setpoint Schedule, !- Name
    Temperature,             !- Schedule Type Limits Name
    Through: 12/31,          !- Field 1
    For: AllDays,            !- Field 2
    Until: 06:00, 16.0,      !- Field 3
    Until: 18:00, 20.0,      !- Field 4
    Until: 24:00, 16.0;      !- Field 5

! -----------------------------------------------------------------------------
! OUTPUT VARIABLES (Mandated by Part 2 Section 1.2)
! -----------------------------------------------------------------------------
Output:Variable,
    ZONE1,                   !- Key Value
    Zone Mean Air Temperature, !- Variable Name
    Timestep;                !- Reporting Frequency

Output:Variable,
    ZONE1,                   !- Key Value
    Zone Thermal Comfort Fanger Model PMV, !- Variable Name
    Timestep;                !- Reporting Frequency

Output:Variable,
    ZONE1,                   !- Key Value
    Zone Air CO2 Concentration, !- Variable Name
    Timestep;                !- Reporting Frequency

Output:Variable,
    *,                       !- Key Value
    Facility Total Electricity Demand Rate, !- Variable Name
    Timestep;                !- Reporting Frequency

! -----------------------------------------------------------------------------
! ENERGY MANAGEMENT SYSTEM ACTUATORS (Mandated by Part 2 Section 1.2)
! -----------------------------------------------------------------------------
EnergyManagementSystem:Actuator,
    Zone1CoolingSetpointActuator, !- Name
    Zone1 Cooling Setpoint Schedule, !- Actuated Component Unique Name
    Schedule:Compact,        !- Actuated Component Type
    Schedule Value;          !- Actuated Component Control Type

EnergyManagementSystem:Actuator,
    Zone1HeatingSetpointActuator, !- Name
    Zone1 Heating Setpoint Schedule, !- Actuated Component Unique Name
    Schedule:Compact,        !- Actuated Component Type
    Schedule Value;          !- Actuated Component Control Type
